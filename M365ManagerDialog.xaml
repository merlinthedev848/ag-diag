<Window x:Class="agilicomsptoolkit.M365ManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Microsoft 365 &amp; Teams Automation" Height="680" Width="980"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Loaded="Window_Loaded">

    <Border CornerRadius="8" Background="#E60f172a" Margin="15">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.3" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" CornerRadius="8,8,0,0" Background="#000033" Padding="20,15" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <TextBlock Text="Microsoft 365 &amp; Teams Automation Tool" FontSize="15" FontWeight="SemiBold" Foreground="#ffffff" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock x:Name="TxtStatus" Text="Ready" Foreground="#94a3b8" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content Split Panel -->
            <Grid Grid.Row="1" Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="540"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Panel: Configuration Form -->
                <Grid Grid.Column="0">
                    <TabControl x:Name="MainTabControl" Background="Transparent" BorderThickness="0" SelectionChanged="TabControl_SelectionChanged">
                        <TabControl.Resources>
                            <Style TargetType="TabItem">
                                <Setter Property="HeaderTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <ContentPresenter Content="{TemplateBinding Content}" Margin="10,6" />
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#94a3b8"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TabItem">
                                            <Border x:Name="Border" Background="{TemplateBinding Background}" BorderThickness="0,0,0,2" BorderBrush="Transparent" Margin="0,0,10,5">
                                                <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header" RecognizesAccessKey="True"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Border" Property="BorderBrush" Value="#0ea5e9"/>
                                                    <Setter Property="Foreground" Value="#ffffff"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Foreground" Value="#e2e8f0"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TabControl.Resources>

                        <!-- TAB 1: Prerequisites & Modules -->
                        <TabItem Header="Connections &amp; Setup">
                            <StackPanel Margin="0,15,0,0">
                                <Border Background="#1e293b" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                                    <StackPanel>
                                        <TextBlock Text="PowerShell Module Status" FontWeight="Bold" Foreground="White" FontSize="13" Margin="0,0,0,8"/>
                                        <TextBlock x:Name="TxtModuleStatus" Text="Verifying local admin modules..." Foreground="#cbd5e1" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                        <Button x:Name="BtnInstallModules" Content="Install Required Modules (Graph / Exchange)" Height="35" Width="300" HorizontalAlignment="Left" Background="#0f172a" Foreground="White" BorderBrush="#334155" Cursor="Hand" Click="BtnInstallModules_Click">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="6"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <Border Background="#1e293b" CornerRadius="8" Padding="15">
                                    <StackPanel>
                                        <TextBlock Text="Interactive Connection Actions" FontWeight="Bold" Foreground="White" FontSize="13" Margin="0,0,0,8"/>
                                        <TextBlock Text="Click to log in and pre-authenticate. Modern OAuth browser prompts will appear." Foreground="#94a3b8" FontSize="11" Margin="0,0,0,12"/>
                                        
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Button x:Name="BtnConnectExchange" Content="Connect Exchange Online" Height="35" Width="220" Background="#064e3b" Foreground="#10b981" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" Click="BtnConnectExchange_Click" Margin="0,0,15,0">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="6"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>
                                            <TextBlock x:Name="TxtExchangeStatus" Text="🔴 Disconnected" Foreground="#ef4444" VerticalAlignment="Center" FontWeight="Bold" FontSize="11"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="BtnConnectGraph" Content="Connect Microsoft Graph" Height="35" Width="220" Background="#064e3b" Foreground="#10b981" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" Click="BtnConnectGraph_Click" Margin="0,0,15,0">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="6"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>
                                            <TextBlock x:Name="TxtGraphStatus" Text="🔴 Disconnected" Foreground="#ef4444" VerticalAlignment="Center" FontWeight="Bold" FontSize="11"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </TabItem>

                        <!-- TAB 2: Mailbox & Calendar Delegation -->
                        <TabItem Header="Delegations">
                            <StackPanel Margin="0,15,0,0">
                                <TextBlock Text="Target User Mailbox UPN" Foreground="#cbd5e1" FontSize="11" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtMailboxUPN" Height="30" Background="#1e293b" Foreground="White" BorderBrush="#334155" VerticalContentAlignment="Center" Padding="5,0" Margin="0,0,0,12" TextChanged="FormInputChanged"/>

                                <TextBlock Text="Delegate User UPN" Foreground="#cbd5e1" FontSize="11" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtDelegateUPN" Height="30" Background="#1e293b" Foreground="White" BorderBrush="#334155" VerticalContentAlignment="Center" Padding="5,0" Margin="0,0,0,15" TextChanged="FormInputChanged"/>

                                <Border Background="#1e293b" CornerRadius="8" Padding="15" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="Mailbox Permission" Foreground="White" FontWeight="Bold" FontSize="12" Margin="0,0,0,6"/>
                                            <ComboBox x:Name="ComboMailboxPerm" Height="28" Background="#0f172a" Foreground="Black" SelectedIndex="0" SelectionChanged="FormInputChanged">
                                                <ComboBoxItem Content="None"/>
                                                <ComboBoxItem Content="FullAccess"/>
                                                <ComboBoxItem Content="SendAs"/>
                                                <ComboBoxItem Content="SendOnBehalf"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <TextBlock Text="Calendar Permission" Foreground="White" FontWeight="Bold" FontSize="12" Margin="0,0,0,6"/>
                                            <ComboBox x:Name="ComboCalendarPerm" Height="28" Background="#0f172a" Foreground="Black" SelectedIndex="0" SelectionChanged="FormInputChanged">
                                                <ComboBoxItem Content="None"/>
                                                <ComboBoxItem Content="Reviewer (Read)"/>
                                                <ComboBoxItem Content="Author (Create)"/>
                                                <ComboBoxItem Content="Editor (Edit)"/>
                                                <ComboBoxItem Content="Owner (Full)"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                
                                <TextBlock Text="Note: Mailbox changes require Exchange Online module. Calendar adjustments set permissions on the subfolder '\Calendar'." Foreground="#94a3b8" FontSize="10" TextWrapping="Wrap" FontStyle="Italic"/>
                            </StackPanel>
                        </TabItem>

                        <!-- TAB 3: Password & Security Reset -->
                        <TabItem Header="User Security">
                            <StackPanel Margin="0,15,0,0">
                                <TextBlock Text="Target User UPN" Foreground="#cbd5e1" FontSize="11" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtSecurityUserUPN" Height="30" Background="#1e293b" Foreground="White" BorderBrush="#334155" VerticalContentAlignment="Center" Padding="5,0" Margin="0,0,0,12" TextChanged="FormInputChanged"/>

                                <Border Background="#1e293b" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                                    <StackPanel>
                                        <TextBlock Text="Password Reset &amp; Quarantine Action" Foreground="White" FontWeight="Bold" FontSize="12" Margin="0,0,0,10"/>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="TxtResetPassword" Grid.Column="0" Height="28" Background="#0f172a" Foreground="White" BorderBrush="#334155" VerticalContentAlignment="Center" Padding="5,0" Margin="0,0,10,0" TextChanged="FormInputChanged"/>
                                            <Button x:Name="BtnGeneratePass" Grid.Column="1" Content="Generate" Width="80" Height="28" Background="#334155" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnGeneratePass_Click">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="4"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>
                                        </Grid>

                                        <CheckBox x:Name="ChkForceChange" Content="Force password change on next sign-in" Foreground="White" Margin="0,0,0,12" IsChecked="True" Checked="FormInputChanged" Unchecked="FormInputChanged"/>
                                        <CheckBox x:Name="ChkRevokeSessions" Content="Revoke all active login sessions (Forces instant logout)" Foreground="White" Margin="0,0,0,12" IsChecked="True" Checked="FormInputChanged" Unchecked="FormInputChanged"/>
                                        
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Account Status:" Foreground="#cbd5e1" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <ComboBox x:Name="ComboAccountState" Width="185" Height="25" SelectedIndex="0" SelectionChanged="FormInputChanged">
                                                <ComboBoxItem Content="Keep Current State"/>
                                                <ComboBoxItem Content="Enabled (Sign-in OK)"/>
                                                <ComboBoxItem Content="Disabled (Block Sign-in)"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </TabItem>

                        <!-- TAB 4: Teams & Groups -->
                        <TabItem Header="Teams &amp; Groups">
                            <StackPanel Margin="0,15,0,0">
                                <TextBlock Text="Target Group/Team UPN or GUID" Foreground="#cbd5e1" FontSize="11" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtGroupUPN" Height="30" Background="#1e293b" Foreground="White" BorderBrush="#334155" VerticalContentAlignment="Center" Padding="5,0" Margin="0,0,0,12" TextChanged="FormInputChanged"/>

                                <TextBlock Text="User UPN" Foreground="#cbd5e1" FontSize="11" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtGroupMemberUPN" Height="30" Background="#1e293b" Foreground="White" BorderBrush="#334155" VerticalContentAlignment="Center" Padding="5,0" Margin="0,0,0,15" TextChanged="FormInputChanged"/>

                                <Border Background="#1e293b" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                                    <StackPanel>
                                        <TextBlock Text="Membership Settings" Foreground="White" FontWeight="Bold" FontSize="12" Margin="0,0,0,10"/>
                                        
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <TextBlock Text="Role Type:" Foreground="#cbd5e1" VerticalAlignment="Center" Margin="0,0,15,0"/>
                                            <RadioButton x:Name="RadioMember" Content="Member" Foreground="White" IsChecked="True" Checked="FormInputChanged" Margin="0,0,20,0"/>
                                            <RadioButton x:Name="RadioOwner" Content="Owner" Foreground="White" Checked="FormInputChanged"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <TextBlock Text="Operation:" Foreground="#cbd5e1" VerticalAlignment="Center" Margin="0,0,15,0"/>
                                            <ComboBox x:Name="ComboGroupOp" Width="180" Height="25" SelectedIndex="0" SelectionChanged="FormInputChanged">
                                                <ComboBoxItem Content="Add to Group / Team"/>
                                                <ComboBoxItem Content="Remove from Group / Team"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </TabItem>
                    </TabControl>
                </Grid>

                <!-- Divider -->
                <Grid Grid.Column="1"/>

                <!-- Right Panel: Script Preview & Run Console -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="PowerShell Code Preview" FontWeight="SemiBold" Foreground="#0ea5e9" FontSize="12" Margin="0,0,0,8"/>
                    
                    <Border Grid.Row="1" Background="#0f172a" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="10">
                        <TextBox x:Name="TxtScriptPreview" IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="Transparent" Foreground="#10b981" BorderThickness="0" FontFamily="Consolas" FontSize="11" Text="Select a tab and configure fields to generate automation script."/>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,15,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnCopyScript" Grid.Column="0" Content="Copy Script" Height="35" Margin="0,0,8,0" Background="#1e293b" Foreground="White" BorderBrush="#334155" Cursor="Hand" Click="BtnCopyScript_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button x:Name="BtnRunScript" Grid.Column="1" Content="Run Script Interactively" Height="35" Margin="8,0,0,0" Background="#0ea5e9" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="BtnRunScript_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Footer -->
            <Border Grid.Row="2" Background="#CC1e293b" CornerRadius="0,0,8,8" Padding="20,15">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Close" Width="100" Height="35" Background="#000033" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnClose_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
