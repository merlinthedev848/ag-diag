<Window x:Class="agilicomsptoolkit.TicketDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Raise Helpdesk Ticket" Height="550" Width="600"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Topmost="True">
    
    <Border CornerRadius="8" Background="#E60f172a" Margin="15">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.3" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Navy Blue Header -->
            <Border Grid.Row="0" Background="#000033" CornerRadius="8,8,0,0" Padding="20,15">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Raise Helpdesk Ticket" FontSize="15" FontWeight="SemiBold" Foreground="#ffffff" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
 
            <!-- Content Area -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="20,20,20,20">
                <StackPanel>
                    <TextBlock Text="Submit diagnostic reports and network captures directly to Agilico Support." FontSize="13" Foreground="#94a3b8" Margin="0,0,0,20" TextWrapping="Wrap"/>
                    
                    <Border Background="#1e293b" CornerRadius="6" BorderBrush="#334155" BorderThickness="1" Padding="15">
                        <StackPanel>
                            <!-- Email -->
                            <TextBlock Text="Your Email Address:" FontWeight="SemiBold" FontSize="12" Foreground="#f1f5f9" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtEmail" Padding="8,6" Margin="0,0,0,12" FontSize="12" Background="#0f172a" Foreground="#f1f5f9" BorderBrush="#334155" BorderThickness="1" VerticalContentAlignment="Center"/>
 
                            <!-- Subject -->
                            <TextBlock Text="Subject:" FontWeight="SemiBold" FontSize="12" Foreground="#f1f5f9" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtSubject" Padding="8,6" Margin="0,0,0,12" FontSize="12" Background="#0f172a" Foreground="#f1f5f9" BorderBrush="#334155" BorderThickness="1" VerticalContentAlignment="Center"/>
 
                            <!-- Description -->
                            <TextBlock Text="Issue Details / Comments:" FontWeight="SemiBold" FontSize="12" Foreground="#f1f5f9" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtDescription" Height="110" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="8,6" FontSize="12" Background="#0f172a" Foreground="#f1f5f9" BorderBrush="#334155" BorderThickness="1"/>
 
                            <!-- Attachment Notice -->
                            <Border Background="#0f172a" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,12,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Data="M16.5,6V17.5A4,4 0 0,1 12.5,21.5A4,4 0 0,1 8.5,17.5V5A2.5,2.5 0 0,1 11,2.5A2.5,2.5 0 0,1 13.5,5V15.5A1,1 0 0,1 12.5,16.5A1,1 0 0,1 11.5,15.5V6H10V15.5A2.5,2.5 0 0,0 12.5,18A2.5,2.5 0 0,0 15,15.5V5A4,4 0 0,0 11,1A4,4 0 0,0 7,5V17.5A5.5,5.5 0 0,0 12.5,23A5.5,5.5 0 0,0 18,17.5V6H16.5Z" 
                                          Fill="#64748b" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtAttachmentsInfo" Text="Automatically attaching: diagnostic_report.txt, diagnostics.pcap" 
                                               FontSize="11" Foreground="#64748b" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
 
            <!-- Footer Area -->
            <Border Grid.Row="2" Background="#CC1e293b" CornerRadius="0,0,8,8" Padding="20,15">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnCancel" Content="Cancel" Width="120" Height="35" Margin="0,0,10,0" Background="Transparent" Foreground="#f1f5f9" BorderThickness="1" BorderBrush="#475569" Cursor="Hand" Click="BtnCancel_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button x:Name="BtnCreateDraft" Content="Create Outlook Draft" Width="160" Height="35" Background="#000033" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnCreateDraft_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
