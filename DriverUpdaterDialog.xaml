<Window x:Class="agilicomsptoolkit.DriverUpdaterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Driver Management &amp; Updates" Height="650" Width="980"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Loaded="Window_Loaded">
    
    <Border CornerRadius="8" Background="#E60f172a" Margin="15">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.3" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Header -->
            <Border Grid.Row="0" CornerRadius="8,8,0,0" Background="#000033" Padding="20,15" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <TextBlock Text="Driver Management &amp; Updates" FontSize="15" FontWeight="SemiBold" Foreground="#ffffff" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock x:Name="TxtStatus" Text="Ready" Foreground="#94a3b8" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- Controls & Filter Bar -->
            <Border Grid.Row="1" Background="#1E293B" Padding="15,10" BorderBrush="#334155" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Search -->
                        <ColumnDefinition Width="Auto"/> <!-- Category -->
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/> <!-- Buttons -->
                    </Grid.ColumnDefinitions>

                    <!-- Search Box -->
                    <StackPanel Orientation="Horizontal" Grid.Column="0" Margin="0,0,15,0">
                        <TextBlock Text="Search:" VerticalAlignment="Center" Foreground="#cbd5e1" FontWeight="SemiBold" Margin="0,0,8,0"/>
                        <TextBox x:Name="TxtDriverSearch" Width="180" Height="30" Padding="8,4" Background="#0f172a" Foreground="White" BorderBrush="#475569" TextChanged="TxtDriverSearch_TextChanged"/>
                    </StackPanel>

                    <!-- Category Filter -->
                    <StackPanel Orientation="Horizontal" Grid.Column="1" Margin="0,0,15,0">
                        <TextBlock Text="Class:" VerticalAlignment="Center" Foreground="#cbd5e1" FontWeight="SemiBold" Margin="0,0,8,0"/>
                        <ComboBox x:Name="CmbDriverClass" Width="140" Height="30" Padding="6,4" SelectionChanged="CmbDriverClass_SelectionChanged">
                            <ComboBoxItem Content="All Classes" IsSelected="True"/>
                            <ComboBoxItem Content="Display / GPU"/>
                            <ComboBoxItem Content="Network / Wi-Fi"/>
                            <ComboBoxItem Content="Bluetooth"/>
                            <ComboBoxItem Content="Audio / Media"/>
                            <ComboBoxItem Content="Storage / Disk"/>
                            <ComboBoxItem Content="System / Chipset"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Action Buttons -->
                    <StackPanel Orientation="Horizontal" Grid.Column="3">
                        <Button x:Name="BtnScanHardware" Content="Scan Hardware" Width="130" Height="30" Background="#334155" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0" Click="BtnScanHardware_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button x:Name="BtnCheckUpdates" Content="Check Windows Update" Width="170" Height="30" Background="#0ea5e9" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnCheckUpdates_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content Area with Tabs -->
            <TabControl Grid.Row="2" x:Name="DriverTabControl" Background="Transparent" BorderThickness="0" Margin="15,10,15,10">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border x:Name="TabBorder" Background="#1e293b" CornerRadius="4,4,0,0" Margin="0,0,4,0" Padding="14,8" Cursor="Hand">
                                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="TabBorder" Property="Background" Value="#0ea5e9"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>

                <!-- TAB 1: INSTALLED HARDWARE DRIVERS -->
                <TabItem Header="Installed Drivers">
                    <Grid Margin="0,10,0,0">
                        <DataGrid x:Name="GridDrivers" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                  Background="Transparent" RowBackground="Transparent" AlternatingRowBackground="#0Affffff"
                                  BorderThickness="0" GridLinesVisibility="None" Foreground="#cbd5e1"
                                  ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto" RowHeight="32">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#334155"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="10,8"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,0"/>
                                    <Setter Property="BorderBrush" Value="#475569"/>
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="10,6"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridCell">
                                                <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#1e40af"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Device Name" Binding="{Binding DeviceName}" Width="2*"/>
                                <DataGridTextColumn Header="Class" Binding="{Binding DeviceClass}" Width="120"/>
                                <DataGridTextColumn Header="Manufacturer" Binding="{Binding Manufacturer}" Width="1.5*"/>
                                <DataGridTextColumn Header="Driver Version" Binding="{Binding DriverVersion}" Width="130"/>
                                <DataGridTextColumn Header="Driver Date" Binding="{Binding DriverDateDisplay}" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- TAB 2: AVAILABLE DRIVER UPDATES -->
                <TabItem Header="Available Driver Updates">
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Updates List or Empty Card -->
                        <Grid Grid.Row="0">
                            <!-- Empty / Up-to-date Card -->
                            <Border x:Name="PanelNoUpdates" Background="#1e293b" CornerRadius="8" Padding="30" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="?" FontSize="36" FontWeight="Bold" Foreground="#10b981" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                    <TextBlock Text="All Hardware Drivers are Up to Date" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                    <TextBlock Text="No pending driver updates were found on Microsoft Update." FontSize="12" Foreground="#94a3b8" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Updates Grid -->
                            <DataGrid x:Name="GridDriverUpdates" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                      Background="Transparent" RowBackground="Transparent" AlternatingRowBackground="#0Affffff"
                                      BorderThickness="0" GridLinesVisibility="None" Foreground="#cbd5e1"
                                      ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto" RowHeight="36">
                                <DataGrid.Resources>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#334155"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Padding" Value="10,8"/>
                                        <Setter Property="BorderThickness" Value="0,0,1,0"/>
                                        <Setter Property="BorderBrush" Value="#475569"/>
                                    </Style>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="Padding" Value="10,6"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Update Title / Device" Binding="{Binding Title}" Width="2*"/>
                                    <DataGridTextColumn Header="Driver Class" Binding="{Binding DriverClass}" Width="120"/>
                                    <DataGridTextColumn Header="Model" Binding="{Binding DriverModel}" Width="1.5*"/>
                                    <DataGridTextColumn Header="Driver Date" Binding="{Binding DriverDate}" Width="110"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>

                        <!-- Action Bar for Updates -->
                        <Border Grid.Row="1" Background="#1e293b" CornerRadius="6" Padding="15,10" Margin="0,10,0,0">
                            <Grid>
                                <TextBlock x:Name="TxtUpdateProgress" Text="Click 'Upgrade All Drivers' to download and install available driver packages." Foreground="#cbd5e1" VerticalAlignment="Center" FontSize="12"/>
                                <Button x:Name="BtnInstallAllDrivers" Content="Upgrade All Drivers" Width="180" Height="35" Background="#f59e0b" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Right" Click="BtnInstallAllDrivers_Click">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
            
            <!-- Footer -->
            <Border Grid.Row="3" Background="#CC1e293b" CornerRadius="0,0,8,8" Padding="20,12">
                <Grid>
                    <TextBlock x:Name="TxtSummary" Text="Total Drivers: 0" Foreground="#94a3b8" VerticalAlignment="Center" FontSize="12"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnExportCsv" Content="Export Inventory (CSV)" Width="170" Height="32" Background="#334155" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0" Click="BtnExportCsv_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Content="Close" Width="90" Height="32" Background="#475569" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnClose_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
