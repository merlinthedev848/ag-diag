<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AgilicoDiagMac.Views.EngineerPasswordDialog"
        Title="Engineer Verification"
        Width="400" Height="250"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#000033">
  
  <Border CornerRadius="8" Background="#0f172a" Margin="12" BorderBrush="#334155" BorderThickness="1">
    <Grid RowDefinitions="Auto,*,Auto">
      
      <!-- Navy Blue Header -->
      <Border Grid.Row="0" Background="#000033" CornerRadius="7,7,0,0" Padding="20,15">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Path Data="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
                Stroke="#00b862" StrokeThickness="2" Fill="Transparent" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center"/>
          <TextBlock Text="Engineer Verification" FontSize="15" FontWeight="SemiBold" Foreground="#ffffff" VerticalAlignment="Center"/>
        </StackPanel>
      </Border>

      <!-- Content Area -->
      <StackPanel Grid.Row="1" Margin="20,20,20,10" Spacing="10">
        <TextBlock Text="Enter Agilico Engineer Password:" FontSize="13" FontWeight="SemiBold" Foreground="#f1f5f9"/>
        <TextBox x:Name="TxtPassword" Height="32" FontSize="14" PasswordChar="*"
                 Background="#1e293b" Foreground="#f1f5f9" BorderBrush="#334155" BorderThickness="1"
                 CornerRadius="4" VerticalContentAlignment="Center" Padding="8,4"/>
      </StackPanel>

      <!-- Footer Area -->
      <Border Grid.Row="2" Background="#1e293b" CornerRadius="0,0,7,7" Padding="20,12">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
          <Button x:Name="BtnCancel" Content="Cancel" Width="90" Height="32"
                  Background="Transparent" Foreground="#f1f5f9" BorderBrush="#475569" BorderThickness="1"
                  CornerRadius="5" Click="BtnCancel_Click" HorizontalContentAlignment="Center"/>
          <Button x:Name="BtnOk" Content="OK" Width="90" Height="32"
                  Background="#000033" Foreground="#ffffff" BorderThickness="0"
                  CornerRadius="5" Click="BtnOk_Click" HorizontalContentAlignment="Center" FontWeight="SemiBold"/>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
