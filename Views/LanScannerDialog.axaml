<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AgilicoDiagMac.Views.LanScannerDialog"
        Title="macOS Local Subnet Scanner"
        Width="880" Height="560"
        WindowStartupLocation="CenterOwner"
        Background="#0B0F19">
  <Grid Margin="16" RowDefinitions="Auto,Auto,*,Auto">
    <!-- Header -->
    <StackPanel Grid.Row="0" Margin="0,0,0,10">
      <TextBlock Text="Local Network Subnet Scanner" FontSize="18" FontWeight="Bold" Foreground="#F9FAFB"/>
      <TextBlock Text="Discover active hosts, IP assignments, MAC addresses, and hardware vendors on your local subnet." FontSize="12" Foreground="#9CA3AF"/>
    </StackPanel>

    <!-- Control Bar -->
    <Grid Grid.Row="1" Margin="0,0,0,10" ColumnDefinitions="Auto,*,Auto,Auto">
      <Button x:Name="BtnStartScan" Grid.Column="0" Content="Start Subnet Scan" Background="#10B981" Foreground="#FFFFFF" Padding="16,8" FontWeight="SemiBold" CornerRadius="6" Click="BtnStartScan_Click"/>
      <ProgressBar x:Name="PrgScan" Grid.Column="1" Height="8" Margin="16,0" VerticalAlignment="Center" Foreground="#3B82F6" Background="#1F2937" Minimum="0" Maximum="100" Value="0"/>
      <Button x:Name="BtnExportCsv" Grid.Column="2" Content="Export CSV" Margin="0,0,8,0" Background="#374151" Foreground="#F9FAFB" Padding="14,8" CornerRadius="6" Click="BtnExportCsv_Click"/>
      <Button x:Name="BtnClose" Grid.Column="3" Content="Close" Background="#374151" Foreground="#F9FAFB" Padding="14,8" CornerRadius="6" Click="BtnClose_Click"/>
    </Grid>

    <!-- DataGrid -->
    <Border Grid.Row="2" Background="#111827" BorderBrush="#374151" BorderThickness="1" CornerRadius="8" Padding="2">
      <DataGrid x:Name="GridDevices" AutoGenerateColumns="False" IsReadOnly="True"
                GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                Background="Transparent" RowBackground="#111827">
        <DataGrid.Columns>
          <DataGridTextColumn Header="IP Address" Binding="{Binding IpAddress}" Width="150"/>
          <DataGridTextColumn Header="MAC Address" Binding="{Binding MacAddress}" Width="170"/>
          <DataGridTextColumn Header="Hostname" Binding="{Binding Hostname}" Width="200"/>
          <DataGridTextColumn Header="Device Manufacturer" Binding="{Binding Manufacturer}" Width="*"/>
          <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <!-- Footer -->
    <Grid Grid.Row="3" Margin="0,10,0,0" ColumnDefinitions="*,Auto">
      <TextBlock x:Name="TxtStatus" Grid.Column="0" Text="Ready to scan." VerticalAlignment="Center" Foreground="#9CA3AF" FontSize="12"/>
      <TextBlock x:Name="TxtCount" Grid.Column="1" Text="0 devices found" VerticalAlignment="Center" Foreground="#F9FAFB" FontWeight="SemiBold" FontSize="12"/>
    </Grid>
  </Grid>
</Window>
