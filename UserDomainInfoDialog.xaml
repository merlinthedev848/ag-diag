<Window x:Class="agilicomsptoolkit.UserDomainInfoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="User &amp; Domain Info" Height="550" Width="800"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Loaded="Window_Loaded">
    
    <Border CornerRadius="8" Background="#E60f172a" Margin="15">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.3" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Header -->
            <Border Grid.Row="0" CornerRadius="8,8,0,0" Background="#000033" Padding="20,15" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <TextBlock Text="User &amp; Domain Audit" FontSize="15" FontWeight="SemiBold" Foreground="#ffffff" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock x:Name="TxtStatus" Text="Gathering user identity data..." Foreground="#94a3b8" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- Content -->
            <Grid Grid.Row="1" Margin="20">
                <TabControl x:Name="TabInfo" Background="Transparent" BorderThickness="0" Padding="0">
                    <TabControl.Resources>
                        <!-- Tab Item Styling -->
                        <Style TargetType="TabItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border x:Name="Border" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="15,8" Margin="0,0,10,10" Background="Transparent">
                                            <ContentPresenter x:Name="ContentSite" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Border" Property="BorderBrush" Value="#3b82f6"/>
                                                <Setter Property="TextBlock.Foreground" Value="White"/>
                                                <Setter Property="TextBlock.FontWeight" Value="SemiBold"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="False">
                                                <Setter Property="TextBlock.Foreground" Value="#94a3b8"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>

                    <!-- TAB 1: GENERAL INFO -->
                    <TabItem Header="General Info">
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Style for Labels -->
                            <Grid.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#94a3b8"/>
                                    <Setter Property="FontSize" Value="13"/>
                                    <Setter Property="Margin" Value="0,8,0,8"/>
                                </Style>
                                <Style x:Key="ValueStyle" TargetType="TextBox">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontSize" Value="13"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="IsReadOnly" Value="True"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="10,6,0,6"/>
                                </Style>
                            </Grid.Resources>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="User Name:"/>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtUserName" Style="{StaticResource ValueStyle}" Text="-"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="User SID:"/>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtUserSid" Style="{StaticResource ValueStyle}" Text="-"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Domain/Computer:"/>
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtDomain" Style="{StaticResource ValueStyle}" Text="-"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Logon Server:"/>
                            <TextBox Grid.Row="3" Grid.Column="1" x:Name="TxtLogonServer" Style="{StaticResource ValueStyle}" Text="-"/>
                            
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Logon Server IP:"/>
                            <TextBox Grid.Row="4" Grid.Column="1" x:Name="TxtLogonServerIp" Style="{StaticResource ValueStyle}" Text="-"/>
                        </Grid>
                    </TabItem>

                    <!-- TAB 2: GROUPS -->
                    <TabItem Header="Group Memberships">
                        <Grid Margin="0,10,0,0">
                            <DataGrid x:Name="GridGroups" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                      Background="Transparent" RowBackground="Transparent" AlternatingRowBackground="#0Affffff"
                                      BorderThickness="0" GridLinesVisibility="None" Foreground="#cbd5e1">
                                <DataGrid.Resources>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#334155"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Padding" Value="10,8"/>
                                        <Setter Property="BorderThickness" Value="0,0,1,0"/>
                                        <Setter Property="BorderBrush" Value="#475569"/>
                                    </Style>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="Padding" Value="10,8"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#1e40af"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Group Name" Binding="{Binding Name}" Width="250"/>
                                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="150"/>
                                    <DataGridTextColumn Header="SID" Binding="{Binding Sid}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <!-- TAB 3: PRIVILEGES -->
                    <TabItem Header="User Privileges">
                        <Grid Margin="0,10,0,0">
                            <DataGrid x:Name="GridPrivileges" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                      Background="Transparent" RowBackground="Transparent" AlternatingRowBackground="#0Affffff"
                                      BorderThickness="0" GridLinesVisibility="None" Foreground="#cbd5e1">
                                <DataGrid.Resources>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#334155"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Padding" Value="10,8"/>
                                        <Setter Property="BorderThickness" Value="0,0,1,0"/>
                                        <Setter Property="BorderBrush" Value="#475569"/>
                                    </Style>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="Padding" Value="10,8"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#1e40af"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Privilege Name" Binding="{Binding Name}" Width="220"/>
                                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
            
            <!-- Footer -->
            <Border Grid.Row="2" Background="#CC1e293b" CornerRadius="0,0,8,8" Padding="20,15">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Close" Width="100" Height="35" Background="#000033" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnClose_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
