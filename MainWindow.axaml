<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AgilicoDiagMac.MainWindow"
        Title="Agilico MSP Toolkit"
        Width="1140" Height="820"
        MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#000033">

  <Grid ColumnDefinitions="100,*">
    <!-- ========================================================= -->
    <!-- LEFT SIDEBAR (#000033 Agilico Deep Navy)                  -->
    <!-- ========================================================= -->
    <Border Grid.Column="0" Background="#000033">
      <Grid RowDefinitions="90,*,Auto">
        <!-- Brand Logo (Agilico logo - Click to toggle Engineer Mode) -->
        <Border Grid.Row="0" Margin="0,20,0,10" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand" PointerReleased="ImgLogo_PointerReleased">
          <ToolTip.Tip>
            <TextBlock Text="Click to unlock Agilico Engineer Mode"/>
          </ToolTip.Tip>
          <Image Source="avares://agilicomsptoolkit/Assets/logo.png" Width="60" Height="60" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <!-- Navigation Buttons -->
        <StackPanel Grid.Row="1" Margin="0,10,0,0">
          <!-- 1. Dashboard (Always Visible) -->
          <Button x:Name="BtnNavDashboard" Height="65" Width="100" Background="Transparent" BorderThickness="0" CornerRadius="0" Click="BtnNavDashboard_Click">
            <Grid>
              <Border x:Name="StripeDashboard" Width="3" HorizontalAlignment="Left" Background="#00b862"/>
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Path Data="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"
                      Stroke="#ffffff" StrokeThickness="1.8" Fill="Transparent" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center"/>
                <TextBlock Text="Dashboard" FontSize="11" FontWeight="SemiBold" Foreground="#ffffff" Margin="0,4,0,0" HorizontalAlignment="Center"/>
              </StackPanel>
            </Grid>
          </Button>

          <!-- 2. IT Tools (Engineer Mode) -->
          <Button x:Name="BtnNavItTools" Height="65" Width="100" Background="Transparent" BorderThickness="0" CornerRadius="0" Click="BtnNavItTools_Click" IsVisible="False">
            <Grid>
              <Border x:Name="StripeItTools" Width="3" HorizontalAlignment="Left" Background="#00b862" IsVisible="False"/>
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Path Data="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z M15 12a3 3 0 11-6 0 3 3 0 016 0z"
                      Stroke="#ffffff" StrokeThickness="1.8" Fill="Transparent" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center"/>
                <TextBlock Text="IT Tools" FontSize="11" FontWeight="SemiBold" Foreground="#ffffff" Margin="0,4,0,0" HorizontalAlignment="Center"/>
              </StackPanel>
            </Grid>
          </Button>

          <!-- 3. Net Tools (Engineer Mode) -->
          <Button x:Name="BtnNavNetTools" Height="65" Width="100" Background="Transparent" BorderThickness="0" CornerRadius="0" Click="BtnNavNetTools_Click" IsVisible="False">
            <Grid>
              <Border x:Name="StripeNetTools" Width="3" HorizontalAlignment="Left" Background="#00b862" IsVisible="False"/>
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Path Data="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"
                      Stroke="#ffffff" StrokeThickness="1.8" Fill="Transparent" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center"/>
                <TextBlock Text="Net Tools" FontSize="11" FontWeight="SemiBold" Foreground="#ffffff" Margin="0,4,0,0" HorizontalAlignment="Center"/>
              </StackPanel>
            </Grid>
          </Button>

          <!-- 4. Converter (Engineer Mode) -->
          <Button x:Name="BtnNavConverter" Height="65" Width="100" Background="Transparent" BorderThickness="0" CornerRadius="0" Click="BtnNavConverter_Click" IsVisible="False">
            <Grid>
              <Border x:Name="StripeConverter" Width="3" HorizontalAlignment="Left" Background="#00b862" IsVisible="False"/>
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Path Data="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"
                      Stroke="#ffffff" StrokeThickness="1.8" Fill="Transparent" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center"/>
                <TextBlock Text="Converter" FontSize="11" FontWeight="SemiBold" Foreground="#ffffff" Margin="0,4,0,0" HorizontalAlignment="Center"/>
              </StackPanel>
            </Grid>
          </Button>

          <!-- 5. Help (Always Visible) -->
          <Button x:Name="BtnNavHelp" Height="65" Width="100" Background="Transparent" BorderThickness="0" CornerRadius="0" Click="BtnNavHelp_Click">
            <Grid>
              <Border x:Name="StripeHelp" Width="3" HorizontalAlignment="Left" Background="#00b862" IsVisible="False"/>
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Path Data="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                      Stroke="#ffffff" StrokeThickness="1.8" Fill="Transparent" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center"/>
                <TextBlock Text="Help" FontSize="11" FontWeight="SemiBold" Foreground="#ffffff" Margin="0,4,0,0" HorizontalAlignment="Center"/>
              </StackPanel>
            </Grid>
          </Button>

          <!-- 6. Logs (Always Visible) -->
          <Button x:Name="BtnNavLogs" Height="65" Width="100" Background="Transparent" BorderThickness="0" CornerRadius="0" Click="BtnNavLogs_Click">
            <Grid>
              <Border x:Name="StripeLogs" Width="3" HorizontalAlignment="Left" Background="#00b862" IsVisible="False"/>
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Path Data="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                      Stroke="#ffffff" StrokeThickness="1.8" Fill="Transparent" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center"/>
                <TextBlock Text="Logs" FontSize="11" FontWeight="SemiBold" Foreground="#ffffff" Margin="0,4,0,0" HorizontalAlignment="Center"/>
              </StackPanel>
            </Grid>
          </Button>

          <!-- 7. Settings (Engineer Mode) -->
          <Button x:Name="BtnNavSettings" Height="65" Width="100" Background="Transparent" BorderThickness="0" CornerRadius="0" Click="BtnNavSettings_Click" IsVisible="False">
            <Grid>
              <Border x:Name="StripeSettings" Width="3" HorizontalAlignment="Left" Background="#00b862" IsVisible="False"/>
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Path Data="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"
                      Stroke="#ffffff" StrokeThickness="1.8" Fill="Transparent" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center"/>
                <TextBlock Text="Settings" FontSize="11" FontWeight="SemiBold" Foreground="#ffffff" Margin="0,4,0,0" HorizontalAlignment="Center"/>
              </StackPanel>
            </Grid>
          </Button>
        </StackPanel>

        <!-- Version Footer -->
        <StackPanel Grid.Row="2" Margin="0,0,0,20" VerticalAlignment="Bottom" HorizontalAlignment="Center">
          <TextBlock x:Name="TxtAppSubtitle" Text="v4.1.2 (Lite)" FontSize="10.5" Foreground="#f1f5f9" Opacity="0.95" HorizontalAlignment="Center" FontWeight="Medium"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ========================================================= -->
    <!-- MAIN WORKSPACE                                            -->
    <!-- ========================================================= -->
    <Border Grid.Column="1" Background="#000033" Padding="14">
      <Carousel x:Name="PageCarousel">

        <!-- ===================================================== -->
        <!-- PAGE 0: DASHBOARD (Authentic Windows 4.1.2 Lite)      -->
        <!-- ===================================================== -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <Grid ColumnDefinitions="4.4*,4.8*">

            <!-- LEFT COLUMN: Diagnostic Controls, Local Net, Summary -->
            <StackPanel Grid.Column="0" Spacing="14" Margin="0,0,10,0">

              <!-- CARD 1: Diagnostic Controls -->
              <Border Background="#ffffff" CornerRadius="8" Padding="18,16" BoxShadow="0 1 3 0 #10000000">
                <StackPanel Spacing="10">
                  <TextBlock Text="Diagnostic Controls" FontSize="15" FontWeight="Bold" Foreground="#1e293b"/>
                  <TextBlock Text="Validate firewall compatibility for incoming call setup, RFC 6056 port randomization, and packet inspection."
                             TextWrapping="Wrap" Foreground="#64748b" FontSize="11.5" LineHeight="16"/>

                  <!-- Action Buttons -->
                  <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                    <Button x:Name="BtnQuickFix" Background="#ffffff" BorderBrush="#cbd5e1" BorderThickness="1" CornerRadius="5" Padding="14,8" Click="BtnQuickFix_Click">
                      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Path Data="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
                              Stroke="#1e293b" StrokeThickness="2" Fill="Transparent" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock Text="RESET CONNECT" FontWeight="Bold" FontSize="11.5" Foreground="#1e293b" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Button>

                    <Button x:Name="BtnRunDiagnostics" Background="#00b862" CornerRadius="5" Padding="18,8" Click="BtnRunDiagnostics_Click">
                      <TextBlock Text="START DIAGNOSTICS" FontWeight="Bold" FontSize="11.5" Foreground="#ffffff" VerticalAlignment="Center"/>
                    </Button>
                  </StackPanel>

                  <ProgressBar x:Name="PrgOverall" Height="5" Background="#e2e8f0" Foreground="#00b862" Minimum="0" Maximum="100" Value="0" Margin="0,6,0,0"/>
                </StackPanel>
              </Border>

              <!-- CARD 2: Local Network Status -->
              <Border Background="#ffffff" CornerRadius="8" Padding="18,16" BoxShadow="0 1 3 0 #10000000">
                <StackPanel Spacing="8">
                  <TextBlock Text="Local Network Status" FontSize="15" FontWeight="Bold" Foreground="#1e293b"/>
                  <TextBlock Text="Basic IP Configuration" Foreground="#2563eb" FontSize="11.5" Margin="0,-4,0,4"/>

                  <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Status:" FontWeight="SemiBold" Foreground="#1e293b" Margin="0,0,0,4"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Connected" Foreground="#2563eb" FontWeight="Medium" Margin="0,0,0,4"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="IP Address:" FontWeight="SemiBold" Foreground="#1e293b" Margin="0,0,0,4"/>
                    <TextBlock x:Name="TxtLocalIpDisplay" Grid.Row="1" Grid.Column="1" Text="192.168.1.24" Foreground="#1e293b" Margin="0,0,0,4"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Public IP:" FontWeight="SemiBold" Foreground="#1e293b" Margin="0,0,0,4"/>
                    <TextBlock x:Name="TxtPublicIpDisplay" Grid.Row="2" Grid.Column="1" Text="5.2.20.210" Foreground="#1e293b" Margin="0,0,0,4"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Subnet Mask:" FontWeight="SemiBold" Foreground="#1e293b" Margin="0,0,0,4"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="255.255.255.0" Foreground="#1e293b" Margin="0,0,0,4"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Default Gateway:" FontWeight="SemiBold" Foreground="#1e293b" Margin="0,0,0,4"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="192.168.1.1" Foreground="#1e293b" Margin="0,0,0,4"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="DNS Servers:" FontWeight="SemiBold" Foreground="#1e293b" Margin="0,0,0,4"/>
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="8.8.8.8, 8.8.4.4" Foreground="#1e293b" Margin="0,0,0,4"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="VLAN ID:" FontWeight="SemiBold" Foreground="#1e293b" Margin="0,0,0,4"/>
                    <TextBlock Grid.Row="6" Grid.Column="1" Text="Untagged" Foreground="#1e293b" Margin="0,0,0,4"/>

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Wi-Fi:" FontWeight="SemiBold" Foreground="#1e293b" Margin="0,0,0,4"/>
                    <TextBlock Grid.Row="7" Grid.Column="1" Text="Workshop_Provisioning (89% / 802.11ac)" Foreground="#1e293b" Margin="0,0,0,4"/>

                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Download Speed:" FontWeight="SemiBold" Foreground="#1e293b" Margin="0,0,0,4"/>
                    <TextBlock x:Name="TxtDownloadSpeed" Grid.Row="8" Grid.Column="1" Text="Not Tested" Foreground="#64748b" Margin="0,0,0,4"/>

                    <TextBlock Grid.Row="9" Grid.Column="0" Text="Upload Speed:" FontWeight="SemiBold" Foreground="#1e293b"/>
                    <TextBlock x:Name="TxtUploadSpeed" Grid.Row="9" Grid.Column="1" Text="Not Tested" Foreground="#64748b"/>
                  </Grid>
                </StackPanel>
              </Border>

              <!-- CARD 3: Diagnostic Summary -->
              <Border Background="#ffffff" CornerRadius="8" Padding="18,16" BoxShadow="0 1 3 0 #10000000">
                <StackPanel Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <TextBlock Text="Diagnostic Summary" FontSize="15" FontWeight="Bold" Foreground="#1e293b" HorizontalAlignment="Left" Width="380"/>

                  <!-- Default Idle State -->
                  <StackPanel x:Name="PnlSummaryIdle" HorizontalAlignment="Center" Margin="0,10,0,4">
                    <Border Width="40" Height="40" CornerRadius="20" BorderBrush="#94a3b8" BorderThickness="2" HorizontalAlignment="Center" Margin="0,0,0,8">
                      <TextBlock Text="!" FontSize="20" FontWeight="Bold" Foreground="#94a3b8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="No Diagnostics Run Yet" FontSize="13.5" FontWeight="SemiBold" Foreground="#1e293b" HorizontalAlignment="Center"/>
                    <TextBlock Text="Click the 'Start' button above to run checks." FontSize="11.5" Foreground="#64748b" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                  </StackPanel>

                  <!-- Pass State -->
                  <StackPanel x:Name="PnlSummaryPass" HorizontalAlignment="Center" IsVisible="False" Margin="0,10,0,4">
                    <Path Data="M12 2C6.486 2 2 6.486 2 12s4.486 10 10 10 10-4.486 10-10S17.514 2 12 2zm0 18c-4.411 0-8-3.589-8-8s3.589-8 8-8 8 3.589 8 8-3.589 8-8 8zm4.707-12.293-6.707 6.707-3.707-3.707-1.414 1.414 5.121 5.121 8.121-8.121-1.414-1.414z"
                          Fill="#00b862" Width="44" Height="44" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="Environment Ready" FontSize="16" FontWeight="Bold" Foreground="#00b862" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="BadgeScore" Text="Score: 100/100" FontSize="13" FontWeight="SemiBold" Foreground="#1e293b" HorizontalAlignment="Center"/>
                    <TextBlock Text="Your local network setup is fully compatible with Agilico Connect. No issues were detected."
                               TextAlignment="Center" TextWrapping="Wrap" FontSize="11.5" Foreground="#64748b" Width="280" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                  </StackPanel>
                </StackPanel>
              </Border>

            </StackPanel>

            <!-- RIGHT COLUMN: Test Status Card (Full Height) -->
            <Border Grid.Column="1" Background="#ffffff" CornerRadius="8" Padding="18,16" BoxShadow="0 1 3 0 #10000000" Margin="10,0,0,0">
              <Grid RowDefinitions="Auto,*">
                <!-- Header with Select All -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                  <TextBlock Grid.Column="0" Text="Test Status" FontSize="15" FontWeight="Bold" Foreground="#1e293b"/>
                  <CheckBox Grid.Column="1" Content="Select All" IsChecked="True" FontSize="12" Foreground="#1e293b"/>
                </Grid>

                <!-- 10 Diagnostic Checks -->
                <ScrollViewer Grid.Row="1">
                  <StackPanel x:Name="PnlTestCards">

                    <!-- 1. DNS Domain & Resolution Check -->
                    <Border BorderBrush="#f1f5f9" BorderThickness="0,0,0,1" Padding="0,8">
                      <Grid ColumnDefinitions="30,Auto,*">
                        <CheckBox x:Name="ChkTest0" Grid.Column="0" IsChecked="True" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Width="26" Height="26" CornerRadius="13" Background="#f1f5f9" BorderBrush="#cbd5e1" BorderThickness="1" Margin="0,0,10,0"/>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                          <TextBlock Text="DNS Domain &amp; Resolution Check" FontSize="12.5" FontWeight="Bold" Foreground="#1e293b"/>
                          <TextBlock x:Name="TxtTestStatus0" Text="Pending" FontSize="11" Foreground="#64748b"/>
                          <TextBlock x:Name="TxtTestDesc0" IsVisible="False"/>
                        </StackPanel>
                      </Grid>
                    </Border>

                    <!-- 2. Bandwidth Speed Test -->
                    <Border BorderBrush="#f1f5f9" BorderThickness="0,0,0,1" Padding="0,8">
                      <Grid ColumnDefinitions="30,Auto,*">
                        <CheckBox x:Name="ChkTest1" Grid.Column="0" IsChecked="True" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Width="26" Height="26" CornerRadius="13" Background="#f1f5f9" BorderBrush="#cbd5e1" BorderThickness="1" Margin="0,0,10,0"/>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                          <TextBlock Text="Bandwidth Speed Test" FontSize="12.5" FontWeight="Bold" Foreground="#1e293b"/>
                          <TextBlock x:Name="TxtTestStatus1" Text="Pending" FontSize="11" Foreground="#64748b"/>
                          <TextBlock x:Name="TxtTestDesc1" IsVisible="False"/>
                        </StackPanel>
                      </Grid>
                    </Border>

                    <!-- 3. HTTP/HTTPS Outbound Web Probes -->
                    <Border BorderBrush="#f1f5f9" BorderThickness="0,0,0,1" Padding="0,8">
                      <Grid ColumnDefinitions="30,Auto,*">
                        <CheckBox x:Name="ChkTest2" Grid.Column="0" IsChecked="True" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Width="26" Height="26" CornerRadius="13" Background="#f1f5f9" BorderBrush="#cbd5e1" BorderThickness="1" Margin="0,0,10,0"/>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                          <TextBlock Text="HTTP/HTTPS Outbound Web Probes" FontSize="12.5" FontWeight="Bold" Foreground="#1e293b"/>
                          <TextBlock x:Name="TxtTestStatus2" Text="Pending" FontSize="11" Foreground="#64748b"/>
                          <TextBlock x:Name="TxtTestDesc2" IsVisible="False"/>
                        </StackPanel>
                      </Grid>
                    </Border>

                    <!-- 4. NTP Protocol Port Reachability -->
                    <Border BorderBrush="#f1f5f9" BorderThickness="0,0,0,1" Padding="0,8">
                      <Grid ColumnDefinitions="30,Auto,*">
                        <CheckBox x:Name="ChkTest3" Grid.Column="0" IsChecked="True" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Width="26" Height="26" CornerRadius="13" Background="#f1f5f9" BorderBrush="#cbd5e1" BorderThickness="1" Margin="0,0,10,0"/>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                          <TextBlock Text="NTP Protocol Port Reachability" FontSize="12.5" FontWeight="Bold" Foreground="#1e293b"/>
                          <TextBlock x:Name="TxtTestStatus3" Text="Pending" FontSize="11" Foreground="#64748b"/>
                          <TextBlock x:Name="TxtTestDesc3" IsVisible="False"/>
                        </StackPanel>
                      </Grid>
                    </Border>

                    <!-- 5. Google Backup STUN Servers Check -->
                    <Border BorderBrush="#f1f5f9" BorderThickness="0,0,0,1" Padding="0,8">
                      <Grid ColumnDefinitions="30,Auto,*">
                        <CheckBox x:Name="ChkTest4" Grid.Column="0" IsChecked="True" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Width="26" Height="26" CornerRadius="13" Background="#f1f5f9" BorderBrush="#cbd5e1" BorderThickness="1" Margin="0,0,10,0"/>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                          <TextBlock Text="Google Backup STUN Servers Check" FontSize="12.5" FontWeight="Bold" Foreground="#1e293b"/>
                          <TextBlock x:Name="TxtTestStatus4" Text="Pending" FontSize="11" Foreground="#64748b"/>
                          <TextBlock x:Name="TxtTestDesc4" IsVisible="False"/>
                        </StackPanel>
                      </Grid>
                    </Border>

                    <!-- 6. NAT Routing & Gateway Hops Check -->
                    <Border BorderBrush="#f1f5f9" BorderThickness="0,0,0,1" Padding="0,8">
                      <Grid ColumnDefinitions="30,Auto,*">
                        <CheckBox x:Name="ChkTest5" Grid.Column="0" IsChecked="True" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Width="26" Height="26" CornerRadius="13" Background="#f1f5f9" BorderBrush="#cbd5e1" BorderThickness="1" Margin="0,0,10,0"/>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                          <TextBlock Text="NAT Routing &amp; Gateway Hops Check" FontSize="12.5" FontWeight="Bold" Foreground="#1e293b"/>
                          <TextBlock x:Name="TxtTestStatus5" Text="Pending" FontSize="11" Foreground="#64748b"/>
                          <TextBlock x:Name="TxtTestDesc5" IsVisible="False"/>
                        </StackPanel>
                      </Grid>
                    </Border>

                    <!-- 7. NAT Port Randomization (RFC 6056) -->
                    <Border BorderBrush="#f1f5f9" BorderThickness="0,0,0,1" Padding="0,8">
                      <Grid ColumnDefinitions="30,Auto,*">
                        <CheckBox x:Name="ChkTest6" Grid.Column="0" IsChecked="True" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Width="26" Height="26" CornerRadius="13" Background="#f1f5f9" BorderBrush="#cbd5e1" BorderThickness="1" Margin="0,0,10,0"/>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                          <TextBlock Text="NAT Port Randomization (RFC 6056)" FontSize="12.5" FontWeight="Bold" Foreground="#1e293b"/>
                          <TextBlock x:Name="TxtTestStatus6" Text="Pending" FontSize="11" Foreground="#64748b"/>
                          <TextBlock x:Name="TxtTestDesc6" IsVisible="False"/>
                        </StackPanel>
                      </Grid>
                    </Border>

                    <!-- 8. SIP ALG Detection (UDP Port 5060) -->
                    <Border BorderBrush="#f1f5f9" BorderThickness="0,0,0,1" Padding="0,8">
                      <Grid ColumnDefinitions="30,Auto,*">
                        <CheckBox x:Name="ChkTest7" Grid.Column="0" IsChecked="True" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Width="26" Height="26" CornerRadius="13" Background="#f1f5f9" BorderBrush="#cbd5e1" BorderThickness="1" Margin="0,0,10,0"/>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                          <TextBlock Text="SIP ALG Detection (UDP Port 5060)" FontSize="12.5" FontWeight="Bold" Foreground="#1e293b"/>
                          <TextBlock x:Name="TxtTestStatus7" Text="Pending" FontSize="11" Foreground="#64748b"/>
                          <TextBlock x:Name="TxtTestDesc7" IsVisible="False"/>
                        </StackPanel>
                      </Grid>
                    </Border>

                    <!-- 9. Advanced SIP Media (RTP) Quality Simulation -->
                    <Border BorderBrush="#f1f5f9" BorderThickness="0,0,0,1" Padding="0,8">
                      <Grid ColumnDefinitions="30,Auto,*">
                        <CheckBox x:Name="ChkTest8" Grid.Column="0" IsChecked="True" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Width="26" Height="26" CornerRadius="13" Background="#f1f5f9" BorderBrush="#cbd5e1" BorderThickness="1" Margin="0,0,10,0"/>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                          <TextBlock Text="Advanced SIP Media (RTP) Quality Simulation" FontSize="12.5" FontWeight="Bold" Foreground="#1e293b"/>
                          <TextBlock x:Name="TxtTestStatus8" Text="Pending" FontSize="11" Foreground="#64748b"/>
                          <TextBlock x:Name="TxtTestDesc8" IsVisible="False"/>
                        </StackPanel>
                      </Grid>
                    </Border>

                    <!-- 10. Inbound Signalling & Presence (WebSockets) -->
                    <Border BorderBrush="#f1f5f9" BorderThickness="0,0,0,1" Padding="0,8">
                      <Grid ColumnDefinitions="30,Auto,*">
                        <CheckBox x:Name="ChkTest9" Grid.Column="0" IsChecked="True" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Width="26" Height="26" CornerRadius="13" Background="#f1f5f9" BorderBrush="#cbd5e1" BorderThickness="1" Margin="0,0,10,0"/>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                          <TextBlock Text="Inbound Signalling &amp; Presence (WebSockets)" FontSize="12.5" FontWeight="Bold" Foreground="#1e293b"/>
                          <TextBlock x:Name="TxtTestStatus9" Text="Pending" FontSize="11" Foreground="#64748b"/>
                          <TextBlock x:Name="TxtTestDesc9" IsVisible="False"/>
                        </StackPanel>
                      </Grid>
                    </Border>

                  </StackPanel>
                </ScrollViewer>
              </Grid>
            </Border>

          </Grid>
        </ScrollViewer>

        <!-- ===================================================== -->
        <!-- PAGE 1: IT TOOLS (Unlocked via Engineer Mode)         -->
        <!-- ===================================================== -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
          <StackPanel Spacing="16" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="IT Diagnostics &amp; System Tools" FontSize="18" FontWeight="Bold" Foreground="#ffffff"/>
            
            <!-- Category 1: System & Performance Diagnostics -->
            <Border Background="#ffffff" CornerRadius="8" Padding="18">
              <StackPanel Spacing="12">
                <TextBlock Text="macOS Diagnostics &amp; Hardware Health" FontSize="14" FontWeight="Bold" Foreground="#3b82f6"/>
                <WrapPanel>
                  <Button x:Name="BtnHardwareScan" Margin="0,0,10,10" Width="240" Height="48" Background="#f8fafc" BorderBrush="#cbd5e1" BorderThickness="1" CornerRadius="6" Click="BtnHardwareScan_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="💻" FontSize="16" VerticalAlignment="Center"/>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Hardware Diagnostics" FontWeight="Bold" FontSize="11.5" Foreground="#1e293b"/>
                        <TextBlock Text="Check CPU, RAM &amp; Disk Health" FontSize="10" Foreground="#64748b"/>
                      </StackPanel>
                    </StackPanel>
                  </Button>

                  <Button x:Name="BtnWifiScan" Margin="0,0,10,10" Width="240" Height="48" Background="#f8fafc" BorderBrush="#cbd5e1" BorderThickness="1" CornerRadius="6" Click="BtnWifiScan_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="📶" FontSize="16" VerticalAlignment="Center"/>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Wi-Fi Signal Analyzer" FontWeight="Bold" FontSize="11.5" Foreground="#1e293b"/>
                        <TextBlock Text="Inspect RSSI, SNR &amp; Channels" FontSize="10" Foreground="#64748b"/>
                      </StackPanel>
                    </StackPanel>
                  </Button>

                  <Button x:Name="BtnAudioInspect" Margin="0,0,10,10" Width="240" Height="48" Background="#f8fafc" BorderBrush="#cbd5e1" BorderThickness="1" CornerRadius="6" Click="BtnAudioInspect_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="🎙️" FontSize="16" VerticalAlignment="Center"/>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Audio Device Inspector" FontWeight="Bold" FontSize="11.5" Foreground="#1e293b"/>
                        <TextBlock Text="Audit Headsets &amp; Sample Rates" FontSize="10" Foreground="#64748b"/>
                      </StackPanel>
                    </StackPanel>
                  </Button>
                </WrapPanel>
              </StackPanel>
            </Border>

            <!-- Category 2: Network Config & Tuning -->
            <Border Background="#ffffff" CornerRadius="8" Padding="18">
              <StackPanel Spacing="12">
                <TextBlock Text="Network Tuning &amp; Quick Remediation" FontSize="14" FontWeight="Bold" Foreground="#10b981"/>
                <WrapPanel>
                  <Button x:Name="BtnFlushDns" Margin="0,0,10,10" Width="240" Height="48" Background="#f8fafc" BorderBrush="#cbd5e1" BorderThickness="1" CornerRadius="6" Click="BtnFlushDns_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="🔄" FontSize="16" VerticalAlignment="Center"/>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Flush macOS DNS Cache" FontWeight="Bold" FontSize="11.5" Foreground="#1e293b"/>
                        <TextBlock Text="Restart mDNSResponder service" FontSize="10" Foreground="#64748b"/>
                      </StackPanel>
                    </StackPanel>
                  </Button>

                  <Button x:Name="BtnRenewDhcp" Margin="0,0,10,10" Width="240" Height="48" Background="#f8fafc" BorderBrush="#cbd5e1" BorderThickness="1" CornerRadius="6" Click="BtnRenewDhcp_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="🌐" FontSize="16" VerticalAlignment="Center"/>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Renew DHCP Lease" FontWeight="Bold" FontSize="11.5" Foreground="#1e293b"/>
                        <TextBlock Text="Request fresh IP from router" FontSize="10" Foreground="#64748b"/>
                      </StackPanel>
                    </StackPanel>
                  </Button>

                  <Button x:Name="BtnResetClient" Margin="0,0,10,10" Width="240" Height="48" Background="#f8fafc" BorderBrush="#cbd5e1" BorderThickness="1" CornerRadius="6" Click="BtnResetClient_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="🧹" FontSize="16" VerticalAlignment="Center"/>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Clear Client Cache" FontWeight="Bold" FontSize="11.5" Foreground="#1e293b"/>
                        <TextBlock Text="Wipe corrupt temporary state" FontSize="10" Foreground="#64748b"/>
                      </StackPanel>
                    </StackPanel>
                  </Button>
                </WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- ===================================================== -->
        <!-- PAGE 2: NET TOOLS (Unlocked via Engineer Mode)        -->
        <!-- ===================================================== -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
          <StackPanel Spacing="16" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="Network Diagnostic Probes" FontSize="18" FontWeight="Bold" Foreground="#ffffff"/>
            
            <Border Background="#ffffff" CornerRadius="8" Padding="18">
              <StackPanel Spacing="14">
                <TextBlock Text="Advanced Network Inspection Utilities" FontSize="14" FontWeight="Bold" Foreground="#1e293b"/>
                <WrapPanel>
                  <Button x:Name="BtnOpenLanScanner" Margin="0,0,10,10" Width="240" Height="52" Background="#f8fafc" BorderBrush="#cbd5e1" BorderThickness="1" CornerRadius="6" Click="BtnOpenLanScanner_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="🔍" FontSize="18" VerticalAlignment="Center"/>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="LAN Subnet Scanner" FontWeight="Bold" FontSize="12" Foreground="#1e293b"/>
                        <TextBlock Text="Discover subnet IP/MAC/OUI" FontSize="10.5" Foreground="#64748b"/>
                      </StackPanel>
                    </StackPanel>
                  </Button>

                  <Button x:Name="BtnOpenPingTracker" Margin="0,0,10,10" Width="240" Height="52" Background="#f8fafc" BorderBrush="#cbd5e1" BorderThickness="1" CornerRadius="6" Click="BtnOpenPingTracker_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="📈" FontSize="18" VerticalAlignment="Center"/>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Continuous Ping Tracker" FontWeight="Bold" FontSize="12" Foreground="#1e293b"/>
                        <TextBlock Text="Monitor real-time jitter/loss" FontSize="10.5" Foreground="#64748b"/>
                      </StackPanel>
                    </StackPanel>
                  </Button>

                  <Button x:Name="BtnOpenSockets" Margin="0,0,10,10" Width="240" Height="52" Background="#f8fafc" BorderBrush="#cbd5e1" BorderThickness="1" CornerRadius="6" Click="BtnOpenSockets_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="🔌" FontSize="18" VerticalAlignment="Center"/>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Active Sockets Monitor" FontWeight="Bold" FontSize="12" Foreground="#1e293b"/>
                        <TextBlock Text="Audit TCP/UDP port bindings" FontSize="10.5" Foreground="#64748b"/>
                      </StackPanel>
                    </StackPanel>
                  </Button>
                </WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- ===================================================== -->
        <!-- PAGE 3: CONVERTER (Unlocked via Engineer Mode)        -->
        <!-- ===================================================== -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
          <StackPanel Spacing="16" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="Voice Prompt Audio Converter" FontSize="18" FontWeight="Bold" Foreground="#ffffff"/>
            
            <Border Background="#ffffff" CornerRadius="8" Padding="20">
              <StackPanel Spacing="12">
                <TextBlock Text="Telephony Voice Format Converter" FontSize="14" FontWeight="Bold" Foreground="#1e293b"/>
                <TextBlock Text="Convert audio files (MP3, WAV, M4A) to Agilico PBX broadcast-ready format: 8000 Hz, 16-bit Mono CCITT u-Law/a-Law."
                           FontSize="12" Foreground="#64748b" TextWrapping="Wrap"/>
                <Button x:Name="BtnLaunchConverter" Content="Open Audio Converter Utility" Background="#00b862" Foreground="#ffffff" FontWeight="Bold" Padding="16,10" CornerRadius="6" Margin="0,8,0,0" Click="BtnLaunchConverter_Click"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- ===================================================== -->
        <!-- PAGE 4: HELP (Always Accessible)                      -->
        <!-- ===================================================== -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
          <StackPanel Spacing="14" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="Agilico Connect Diagnostic Help &amp; Guidance" FontSize="18" FontWeight="Bold" Foreground="#ffffff"/>
            <Border Background="#ffffff" CornerRadius="8" Padding="20">
              <StackPanel Spacing="12">
                <TextBlock Text="Network Requirements Overview" FontSize="14" FontWeight="Bold" Foreground="#1e293b"/>
                <TextBlock Text="• Outbound Ports: UDP 5060, 5061 (SIP), UDP 10000-20000 (RTP Voice Media), TCP 80/443 (HTTPS WebSockets), UDP 123 (NTP), UDP 3478 (STUN)."
                           FontSize="12" Foreground="#1e293b" TextWrapping="Wrap"/>
                <TextBlock Text="• SIP ALG: Must be DISABLED on customer router/firewall to prevent header corruption and one-way audio."
                           FontSize="12" Foreground="#1e293b" TextWrapping="Wrap"/>
                <TextBlock Text="• Double NAT: Customer devices should maintain a single public IP mapping to avoid registration timeout failures."
                           FontSize="12" Foreground="#1e293b" TextWrapping="Wrap"/>
                <TextBlock Text="• Knowledgebase: https://kb.agilicoconnect.co.uk"
                           FontSize="12" Foreground="#2563eb"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- ===================================================== -->
        <!-- PAGE 5: LOGS & PCAP (Always Accessible)               -->
        <!-- ===================================================== -->
        <Grid RowDefinitions="Auto,*,Auto" Margin="16">
          <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="0,0,0,10">
            <TextBlock Grid.Column="0" Text="Activity &amp; PCAP Logs" FontSize="16" FontWeight="Bold" Foreground="#ffffff" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
              <Button x:Name="BtnTogglePcap" Content="Start PCAP Capture" Background="#ffffff" Foreground="#1e293b" Padding="12,6" CornerRadius="5" Click="BtnTogglePcap_Click"/>
              <Button x:Name="BtnExportPcap" Content="Export PCAP" Background="#ffffff" Foreground="#1e293b" Padding="12,6" CornerRadius="5" Click="BtnExportPcap_Click"/>
            </StackPanel>
            <Button x:Name="BtnExportReport" Grid.Column="3" Content="Export Full Report" Margin="8,0,0,0" Background="#00b862" Foreground="#ffffff" FontWeight="SemiBold" Padding="14,6" CornerRadius="5" Click="BtnExportReport_Click"/>
            <Button x:Name="BtnClearLogs" Grid.Column="4" Content="Clear" Margin="8,0,0,0" Background="#ffffff" Foreground="#1e293b" Padding="12,6" CornerRadius="5" Click="BtnClearLogs_Click"/>
          </Grid>

          <!-- Console Text -->
          <Border Grid.Row="1" Background="#0A0E1A" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="6" Padding="10">
            <ScrollViewer x:Name="ScrLogs">
              <TextBox x:Name="TxtLogs" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                       FontFamily="Consolas,Menlo,Monospace" FontSize="11.5"
                       Foreground="#10B981" Background="Transparent" BorderThickness="0"/>
            </ScrollViewer>
          </Border>

          <!-- Footer -->
          <TextBlock x:Name="TxtPcapStats" Grid.Row="2" Text="PCAP Capturer: Idle (0 packets recorded)" Margin="0,8,0,0" Foreground="#94a3b8" FontSize="12"/>
        </Grid>

        <!-- ===================================================== -->
        <!-- PAGE 6: SETTINGS (Unlocked via Engineer Mode)         -->
        <!-- ===================================================== -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
          <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="Configuration Settings" FontSize="18" FontWeight="Bold" Foreground="#ffffff"/>
            
            <Border Background="#ffffff" CornerRadius="8" Padding="20">
              <StackPanel Spacing="14">
                <TextBlock Text="Diagnostic &amp; Test Parameters" FontSize="14" FontWeight="Bold" Foreground="#1e293b"/>
                
                <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="STUN Server Host/IP:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#1e293b" Margin="0,0,0,10"/>
                  <TextBox x:Name="TxtStunServer" Grid.Row="0" Grid.Column="1" Text="stun-gb-a.hp2k.co.uk" Margin="0,0,0,10"/>

                  <TextBlock Grid.Row="1" Grid.Column="0" Text="STUN Server Port:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#1e293b" Margin="0,0,0,10"/>
                  <TextBox x:Name="TxtStunPort" Grid.Row="1" Grid.Column="1" Text="3478" Margin="0,0,0,10"/>

                  <TextBlock Grid.Row="2" Grid.Column="0" Text="Local SIP Port:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#1e293b" Margin="0,0,0,10"/>
                  <TextBox x:Name="TxtLocalPort" Grid.Row="2" Grid.Column="1" Text="5060" Margin="0,0,0,10"/>

                  <TextBlock Grid.Row="3" Grid.Column="0" Text="SIP ALG Target Server:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#1e293b" Margin="0,0,0,10"/>
                  <TextBox x:Name="TxtSipAlgServer" Grid.Row="3" Grid.Column="1" Text="sip.linphone.org" Margin="0,0,0,10"/>

                  <TextBlock Grid.Row="4" Grid.Column="0" Text="SIP ALG Target Port:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#1e293b"/>
                  <TextBox x:Name="TxtSipAlgPort" Grid.Row="4" Grid.Column="1" Text="5060"/>
                </Grid>

                <CheckBox x:Name="ChkSimulation" Content="Enable Offline Simulation Mode (Mock Network Responses)" FontWeight="SemiBold" Margin="0,8,0,0"/>

                <Button x:Name="BtnSaveSettings" Content="Apply Settings" Background="#00b862" Foreground="#ffffff" FontWeight="Bold" Padding="16,8" CornerRadius="5" HorizontalAlignment="Left" Click="BtnSaveSettings_Click"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

      </Carousel>
    </Border>
  </Grid>
</Window>
