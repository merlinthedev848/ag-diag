<Window x:Class="agilicomsptoolkit.ModernMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Message" Height="Auto" Width="450" MinHeight="200" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Topmost="True" 
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    
    <Border CornerRadius="8" Background="#E60f172a" Margin="15">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.3" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Navy Blue Header with glassmorphism/translucency effect -->
            <Border Grid.Row="0" Background="#000033" CornerRadius="8,8,0,0" Padding="20,15" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal">
                    <Path x:Name="IconPath" Width="22" Height="22" Stretch="Uniform" Fill="#ffffff" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtTitle" FontSize="15" FontWeight="SemiBold" Foreground="#ffffff" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
 
            <!-- Content Area -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="400" Margin="20,20,20,20">
                <TextBlock x:Name="TxtMessage" TextWrapping="Wrap" FontSize="13" Foreground="#f1f5f9" LineHeight="20"/>
            </ScrollViewer>
 
            <!-- Footer Area -->
            <Border Grid.Row="2" Background="#CC1e293b" CornerRadius="0,0,8,8" Padding="20,15">
                <StackPanel x:Name="ButtonPanel" Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- Buttons are generated dynamically in code-behind -->
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
