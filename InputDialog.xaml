<Window x:Class="agilicomsptoolkit.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Input Required" Height="Auto" Width="400" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Topmost="True">
    
    <Border CornerRadius="8" Background="#E60f172a" Margin="15">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.3" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Navy Blue Header -->
            <Border Grid.Row="0" Background="#000033" CornerRadius="8,8,0,0" Padding="20,15" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="TxtTitle" Text="Input Required" FontSize="15" FontWeight="SemiBold" Foreground="#ffffff" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
 
            <!-- Content Area -->
            <StackPanel Grid.Row="1" Margin="20,20,20,20">
                <TextBlock x:Name="TxtInstruction" Text="Please enter a value:" FontSize="13" FontWeight="SemiBold" Foreground="#f1f5f9" Margin="0,0,0,10" TextWrapping="Wrap"/>
                <TextBox x:Name="TxtInput" Height="30" FontSize="14" Padding="5,0" VerticalContentAlignment="Center" Background="#1e293b" Foreground="#f1f5f9" BorderBrush="#334155" BorderThickness="1"/>
            </StackPanel>
 
            <!-- Footer Area -->
            <Border Grid.Row="2" Background="#CC1e293b" CornerRadius="0,0,8,8" Padding="20,15">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnCancel" Content="Cancel" Width="100" Height="35" Margin="0,0,10,0" Background="Transparent" Foreground="#f1f5f9" BorderThickness="1" BorderBrush="#475569" Cursor="Hand" Click="BtnCancel_Click" IsCancel="True">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button x:Name="BtnOk" Content="OK" IsDefault="True" Width="100" Height="35" Background="#000033" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnOk_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
