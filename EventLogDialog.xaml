<Window x:Class="agilicomsptoolkit.EventLogDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Event Log Exporter" Height="600" Width="800"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Loaded="Window_Loaded">
    
    <Border CornerRadius="8" Background="#E60f172a" Margin="15">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.3" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Header -->
            <Border Grid.Row="0" CornerRadius="8,8,0,0" Background="#000033" Padding="20,15" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Event Log Exporter (System - Last 50)" FontSize="15" FontWeight="SemiBold" Foreground="#ffffff" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            
            <!-- Content -->
            <Grid Grid.Row="1" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Summary Cards -->
                <UniformGrid Grid.Row="0" Rows="1" Columns="3" Margin="0,0,0,15">
                    <Border Background="#1e293b" CornerRadius="8" Padding="15" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="ERRORS" Foreground="#ef4444" FontSize="12" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtErrors" Text="-" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#1e293b" CornerRadius="8" Padding="15" Margin="5,0,5,0">
                        <StackPanel>
                            <TextBlock Text="WARNINGS" Foreground="#f59e0b" FontSize="12" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtWarnings" Text="-" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#1e293b" CornerRadius="8" Padding="15" Margin="10,0,0,0">
                        <StackPanel>
                            <TextBlock Text="INFORMATION" Foreground="#3b82f6" FontSize="12" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtInfos" Text="-" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- List of Events -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ItemsLogs">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1e293b" CornerRadius="6" Padding="15" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Icon -->
                                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" Background="{Binding IconBgBrush}" Margin="0,0,15,0" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding IconGlyph}" FontSize="20" FontWeight="Bold" Foreground="{Binding IconFgBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        
                                        <!-- Details -->
                                        <StackPanel Grid.Column="1">
                                            <Grid Margin="0,0,0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Source}" FontWeight="Bold" Foreground="White" FontSize="14"/>
                                                    <TextBlock Text=" • " Foreground="#64748b"/>
                                                    <TextBlock Text="{Binding TimeGenerated}" Foreground="#94a3b8" FontSize="12" VerticalAlignment="Bottom"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="Search Solution" Background="Transparent" Foreground="#3b82f6" BorderThickness="0" Cursor="Hand" Click="BtnSearchSolution_Click" Tag="{Binding}" FontSize="11" VerticalAlignment="Center">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <TextBlock Text="{TemplateBinding Content}" TextDecorations="Underline"/>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </Grid>
                                            <TextBox Text="{Binding Message, Mode=OneWay}" Foreground="#cbd5e1" TextWrapping="Wrap" FontSize="12" IsReadOnly="True" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Arrow" SelectionBrush="#3b82f6"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
            
            <!-- Footer -->
            <Border Grid.Row="2" Background="#CC1e293b" CornerRadius="0,0,8,8" Padding="20,15">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Close" Width="100" Height="35" Background="#000033" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnClose_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
