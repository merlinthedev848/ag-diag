<Window x:Class="agilicomsptoolkit.TermsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Terms of Service" Height="500" Width="600"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Topmost="True">
    
    <Border CornerRadius="8" Background="#E60f172a" Margin="15">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.3" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Navy Blue Header -->
            <Border Grid.Row="0" Background="#000033" CornerRadius="8,8,0,0" Padding="20,15">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Important Notice - Agilico MSP Toolkit" FontSize="15" FontWeight="SemiBold" Foreground="#ffffff" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
 
            <!-- Content Area -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="20,20,20,20">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#f1f5f9" LineHeight="22">
                        <Run FontWeight="Bold">Important Warning and Disclaimers</Run>
                        <LineBreak/><LineBreak/>
                        1. <Run FontWeight="SemiBold">Information Access:</Run> By executing this software, you acknowledge and agree that it will actively access, collect, and transmit technical diagnostic information from your system and network. This includes, but is not limited to, hardware specifications, IP configurations, active background processes, and network latency metrics. This data is utilized solely for the purpose of troubleshooting and resolving connectivity or performance issues.
                        <LineBreak/><LineBreak/>
                        2. <Run FontWeight="SemiBold">Diagnostic Sweeps:</Run> Advanced features such as the Network Scanner, Port Probe, and Packet Capture perform active sweeps across your local subnet. Use these tools <Run FontWeight="Bold">only</Run> on networks where you possess explicit authorization to do so. Unauthorized network scanning may violate corporate IT policies or local regulations.
                        <LineBreak/><LineBreak/>
                        3. <Run FontWeight="SemiBold">Data Transmission:</Run> Diagnostic logs and helpdesk tickets generated by this tool may contain sensitive environmental data (e.g., internal IP addresses, hostname schemas). By submitting a ticket, you consent to this data being securely transmitted to Agilico Support.
                        <LineBreak/><LineBreak/>
                        4. <Run FontWeight="SemiBold">No Liability:</Run> This application is provided "as is" without warranty of any kind. Agilico is not liable for any service disruption, data loss, or incidental damages resulting from the use or misuse of these diagnostic utilities.
                        <LineBreak/><LineBreak/>
                        <Run FontStyle="Italic">Please review these terms carefully. If you do not consent to the collection of diagnostic data or the execution of network sweeps, please exit the application immediately.</Run>
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>
 
            <!-- Footer Area -->
            <Border Grid.Row="2" Background="#CC1e293b" CornerRadius="0,0,8,8" Padding="20,15">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnExit" Content="Decline &amp; Exit" Width="120" Height="35" Margin="0,0,10,0" Background="Transparent" Foreground="#f1f5f9" BorderThickness="1" BorderBrush="#334155" Cursor="Hand" Click="BtnCancel_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button x:Name="BtnAccept" Content="I Accept" Width="120" Height="35" Background="#000033" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnAgree_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
